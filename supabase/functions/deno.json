{
  "compilerOptions": {
    "lib": ["deno.window", "dom", "dom.iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true
  },
  "imports": {
    "@noble/curves/ed25519": "npm:@noble/curves@1.4.0/ed25519",
    "@noble/curves/secp256k1": "npm:@noble/curves@1.4.0/secp256k1",
    "@noble/hashes/ripemd160": "npm:@noble/hashes@1.5.0/ripemd160",
    "@noble/hashes/sha256": "npm:@noble/hashes@1.5.0/sha256",
    "@noble/hashes/sha3": "npm:@noble/hashes@1.5.0/sha3",
    "@noble/post-quantum/ml-dsa.js": "npm:@noble/post-quantum@0.5.4/ml-dsa.js",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.110.9",
    "postgres": "npm:postgres@3.4.9"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": false,
    "singleQuote": true
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  },
  "tasks": {
    "check": "deno check spectra-api/index.ts spectra-janitor/index.ts spectra-wallet-worker/index.ts spectra-market-worker/index.ts spectra-notification-worker/index.ts",
    "test": "deno test --allow-env --allow-net _shared"
  }
}

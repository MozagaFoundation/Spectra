# EAS build archive exclusions.
# Keep this aligned with .gitignore except for android/app/google-services.json,
# which is required by the Android Google Services Gradle plugin.

# Expo-generated patterns
expo-env.d.ts

# Environment and runtime secrets
.env
.env.*
!.env.example
*.env
*.env.*
!.env.example
!ios/.xcode.env
*.tfvars
*.tfvars.json
terraform.tfstate
terraform.tfstate.*
crash.log
crash.*.log
**/.terraform/

# Public repo exclusions
/supabase/
docs/

# Dependencies
node_modules/
**/node_modules/

# Expo
.expo/
.eas/
/dist/
dist/
web-build/

# Native build artifacts
build/
builds/
.gradle/
android/.gradle/
android/build/
android/local.properties
ios/Pods/
ios/build/
ios/.xcode.env.local
.cxx/
DerivedData/
xcuserdata/
*.xcworkspace/xcuserdata/
project.xcworkspace/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xccheckout
*.xcuserstate
*.ipa
*.hprof
*.iml
local.properties
.xcode.env.local

# Native secrets
*.orig.*
*.keystore
*.keystore.properties
*.jks
*.p8
*.p12
*.key
*.pem
*.cer
*.cert
*.mobileprovision
*.provisionprofile
AuthKey_*.p8
credentials.json
eas-credentials.json
app-store-connect*.json
google-services.json
!android/app/google-services.json
android/app/fcm-v1-service-account.json
GoogleService-Info.plist

# Metro
.metro-health-check*

# macOS
.DS_Store

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*

# TypeScript
*.tsbuildinfo

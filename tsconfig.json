{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@spectra/core-crypto": [
        "./packages/spectra-core-crypto/src/index.ts"
      ],
      "@spectra/core-crypto/*": [
        "./packages/spectra-core-crypto/src/*"
      ],
      "@spectra/identity-vault": [
        "./packages/spectra-identity-vault/src/index.ts"
      ],
      "@spectra/identity-vault/*": [
        "./packages/spectra-identity-vault/src/*"
      ],
      "@spectra/privacy-protocol": [
        "./packages/spectra-privacy-protocol/src/index.ts"
      ],
      "@spectra/privacy-protocol/*": [
        "./packages/spectra-privacy-protocol/src/*"
      ],
      "@spectra/public-content": [
        "./packages/spectra-public-content/src/index.ts"
      ],
      "@spectra/public-content/*": [
        "./packages/spectra-public-content/src/*"
      ],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "supabase",
    "native/**/build-test",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
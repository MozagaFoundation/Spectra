# Spectra backend configuration
EXPO_PUBLIC_SPECTRA_API_URL=http://127.0.0.1:54321/functions/v1/spectra-api

# Blockchain/explorer configuration
EXPO_PUBLIC_MOZAGA_RPC_URL=
EXPO_PUBLIC_ETH_EXPLORER_URL=https://etherscan.io
EXPO_PUBLIC_BITCOIN_EXPLORER_URL=https://mempool.space
EXPO_PUBLIC_SOLANA_EXPLORER_URL=https://explorer.solana.com
EXPO_PUBLIC_TRON_EXPLORER_URL=https://tronscan.org/#

# Private chain RPC credentials live in backend server secrets for rpc-proxy:
# MOZAGA_RPC_URL, ETH_RPC_URL, BITCOIN_RPC_URL, SOLANA_RPC_URL, TRON_RPC_URL
# MOZAGA_RPC_BEARER_TOKEN authenticates the private Mozaga endpoint.
# BITCOIN_RPC_USERNAME and BITCOIN_RPC_PASSWORD authenticate a protected Bitcoin node.
# TRON_RPC_API_KEY authenticates a TronGrid or compatible provider.
# Set SPECTRA_WALLET_INDEX_TRUSTED_BALANCE_RPC=true only for reviewed providers.

# Contribution recipient configuration belongs in Edge Function secrets only:
# SPECTRA_CONTRIBUTION_RECIPIENTS_KEY_ID
# SPECTRA_CONTRIBUTION_RECIPIENTS_PAYLOAD_JSON
# SPECTRA_CONTRIBUTION_RECIPIENTS_SIGNING_PRIVATE_KEY_BASE64

# Admin dashboard Supabase auth
# Required for /v1/admin/* endpoints when serving the SpectraWeb2 dashboard.
SPECTRA_ADMIN_SUPABASE_URL=https://replace-with-your-project.supabase.co
SPECTRA_ADMIN_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SPECTRA_ADMIN_ROLE=spectra_admin

{
  "name": "spectra",
  "version": "1.2.5",
  "main": "./index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test:privacy-protocol": "vitest run packages/spectra-privacy-protocol",
    "audit:locales": "node ./scripts/audit-locales.mjs",
    "test": "vitest",
    "test:audit": "vitest run test/testing-library-react-native.test.tsx test/mockHelpers.test.tsx services/security services/backend/session.test.ts services/backend/storageResolver.test.ts services/media services/tor services/notifications services/quantumChat services/storage store/authStore.test.ts \"test/(auth)\"",
    "verify:ios-privacy": "node ./scripts/verify-ios-privacy.mjs",
    "verify:release-config": "node ./scripts/verify-release-config.mjs",
    "verify:public-config": "vitest run scripts/publicConfigGuards.test.mjs scripts/expoAppConfig.test.mjs scripts/loadEasConfig.test.mjs scripts/runEasBuildWithLocalSubmit.test.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop --no-backup",
    "supabase:db:replay": "supabase db reset --local",
    "supabase:db:lint": "supabase db lint --local --level warning --fail-on error",
    "supabase:db:test": "supabase test db supabase/tests/database",
    "supabase:edge:fmt": "deno fmt --check --config supabase/functions/deno.json supabase/functions && deno fmt --check --config supabase/deno.json supabase/tests",
    "supabase:edge:lint": "deno lint --config supabase/functions/deno.json supabase/functions && deno lint --config supabase/deno.json supabase/tests",
    "supabase:edge:check": "deno task --config supabase/functions/deno.json check && deno task --config supabase/deno.json check",
    "supabase:edge:test": "deno test --config supabase/functions/deno.json --allow-env supabase/functions/_shared",
    "supabase:contracts": "deno task --config supabase/deno.json test",
    "supabase:deploy:validate": "npm run supabase:edge:fmt && npm run supabase:edge:lint && npm run supabase:edge:check && npm run supabase:edge:test && npm run supabase:contracts",
    "eas:build:ios:production:submit": "node ./scripts/runEasBuildWithLocalSubmit.mjs -- build --platform ios --profile production --auto-submit",
    "benchmark:pbkdf2:js": "node ./scripts/benchmark-pbkdf2-js.mjs",
    "benchmark:media:crypto": "node ./scripts/benchmark-media-crypto.mjs",
    "benchmark:dilithium:verify": "node ./scripts/benchmark-dilithium-verify.mjs",
    "eas-build-post-install": "node ./scripts/eas-build-post-install.mjs",
    "postinstall": "patch-package"
  },
  "engines": {
    "node": ">=20.19.4 <21"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
